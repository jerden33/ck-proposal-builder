# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=https://circlek.pro

# Mapbox Token (if used)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Supabase service-role key (server-only, never expose to the client)
# Used by the Partner Intake form to upload files and write submissions
# bypassing RLS. Found in Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (transactional email) — used by the Partner Intake form
RESEND_API_KEY=your-resend-api-key
# Must be a verified sender on your Resend domain
PARTNER_INTAKE_FROM_EMAIL=Fleet Insights <onboarding@resend.dev>
PARTNER_INTAKE_NOTIFY_EMAIL=jordan.henderson@circlek.com
